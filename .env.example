# NAMOA public installer configuration.
# Copy this file to .env and adjust the paths and UID/GID for your host.

# Port exposed on the host.
NAMOA_PORT=8080

# Container image tag. Use a release tag in production, for example v0.1.0.
NAMOA_VERSION=latest

# Host path to the media library. It is mounted at the same path inside
# the container so database paths remain valid.
NAMOA_MEDIA_ROOT=/mnt/media

# Persistent host directories.
NAMOA_DATA_DIR=./data
NAMOA_CONFIG_DIR=./config-data
NAMOA_LOG_DIR=./logs

# UID and GID that own the persistent directories and can write to media.
# The installer sets these to the current user when it creates .env.
PUID=1000
PGID=1000
